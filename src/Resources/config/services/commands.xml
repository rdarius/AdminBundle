<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="admin_platform.factory.admin_user" class="Sylius\Component\Resource\Factory\Factory">
            <argument>Platform\Bundle\AdminBundle\Model\AdminUser</argument>
        </service>

        <service id="admin_platform.command.setup" class="Platform\Bundle\AdminBundle\Command\SetupCommand">
            <argument type="service" id="admin_platform.setup.locale" />
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="admin_platform.factory.admin_user" />
            <argument type="service" id="sylius.repository.admin_user" />
            <argument type="service" id="validator" />

            <tag name="console.command" command="admin-platform:install:setup" />
        </service>
    </services>
</container>
